{
  "name": "sola-lens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "SOLA_INCLUDE_DEV_PAGES=1 next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:dev && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:export",
    "format:check": "prettier --check .",
    "build:dev": "SOLA_INCLUDE_DEV_PAGES=1 next build"
  },
  "dependencies": {
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.7.1",
    "@simplewebauthn/server": "14.0.3",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "jose": "6.2.13",
    "mipd": "0.0.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ethers": "6.13.5",
    "prettier": "3.9.10",
    "tweetnacl": "1.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
